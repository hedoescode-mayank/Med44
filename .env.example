# Med44 Backend Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq API (optional - app works offline without this)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database
DATABASE_URL=sqlite+aiosqlite:///./med44.db

# App Settings
DEMO_MODE=true
APP_NAME=Med44
APP_VERSION=1.0.0
