# Med44 Backend Configuration
# Copy to .env — never commit .env to git

# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Mode ──────────────────────────────────────────────────────────────────────
# TEST = permissive CORS, test emails, labelled test data
# PRODUCTION = restricted CORS, real patients, clinician-approved rules only
MED44_MODE=TEST

# ── CORS (used in PRODUCTION mode; in TEST mode all origins allowed) ──────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./med44.db

# ── Groq AI (optional — app works fully offline without this) ─────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_ENGINE=tesseract
# Windows: set to full path e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_MAX_FILE_MB=10
OCR_MAX_PAGES=10
OCR_TEMP_TTL_SECONDS=300

# ── Email notifications ───────────────────────────────────────────────────────
EMAIL_PROVIDER=gmail_smtp
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ── Test identities (TEST mode only) ─────────────────────────────────────────
# Never hardcode in source — always via env
TEST_DOCTOR_EMAIL=
TEST_PATIENT_EMAIL=

# ── Emergency ─────────────────────────────────────────────────────────────────
EMERGENCY_NUMBER=
EMERGENCY_NUMBER_VERIFIED_BY=

# ── App ───────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:5173
DEMO_MODE=true
APP_NAME=Med44
APP_VERSION=1.1.0

# ── SMS (optional future) ─────────────────────────────────────────────────────
SMS_PROVIDER=
